# Copy this file to .env.local and fill in the two values below.
# You'll find them in your Supabase project dashboard under
# Project Settings -> API.
#
# NEXT_PUBLIC_SUPABASE_URL looks like: https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the long "anon public" key (safe to
# expose in the browser -- it only grants what your database's Row
# Level Security policies allow).
#
# See README.md for the full step-by-step setup guide.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
